EXPO_PUBLIC_API_URL=https://www.stonkwatcher.xyz
EXPO_PUBLIC_PARTNER_API_KEY=

# Privy (https://dashboard.privy.io) — required for in-app Solana wallets
EXPO_PUBLIC_PRIVY_APP_ID=
EXPO_PUBLIC_PRIVY_CLIENT_ID=
# Hosted web page that calls Privy exportWallet for Solana (Base58)
EXPO_PUBLIC_PRIVY_KEY_EXPORT_URL=https://www.stonkwatcher.xyz/wallet/export

EXPO_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# 0.5% = 50 bps platform fee on live Jupiter swaps
EXPO_PUBLIC_PLATFORM_FEE_BPS=50
EXPO_PUBLIC_PLATFORM_FEE_ACCOUNT=

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- OpenTelemetry request tracing (optional; tracing is off when no endpoint is set) ---
# OTLP/HTTP (JSON) collector base URL; the app posts to <endpoint>/v1/traces.
# Use EXPO_PUBLIC_OTEL_EXPORTER_OTLP_TRACES_ENDPOINT instead to give the full traces URL.
EXPO_PUBLIC_OTEL_EXPORTER_OTLP_ENDPOINT=
# Optional "key=value,key2=value2" headers for the collector. EXPO_PUBLIC_ values ship
# inside the app bundle, so only use a public/ingest-only token here, never a secret key.
EXPO_PUBLIC_OTEL_EXPORTER_OTLP_HEADERS=
# Fraction of new traces to keep, 0-1 (default 1).
EXPO_PUBLIC_OTEL_TRACES_SAMPLE_RATE=1
# Requests at or above this many ms get app.request.slow=true and a slow_request event (default 2000).
EXPO_PUBLIC_OTEL_SLOW_REQUEST_MS=2000
# Defaults to development/production from the build type.
EXPO_PUBLIC_OTEL_ENVIRONMENT=
# traceparent is sent only to EXPO_PUBLIC_API_URL plus these comma-separated origins.
EXPO_PUBLIC_OTEL_PROPAGATE_ORIGINS=
# Web only: set to 1 once the API's CORS allows the traceparent and tracestate headers.
EXPO_PUBLIC_OTEL_PROPAGATE_ON_WEB=0
